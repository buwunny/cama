# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A high-performance LLM inference engine in OxCaml"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.17"}
  "base"
  "core"
  "core_unix"
  "ocaml_simd"
  "unboxed"
  "parallel"
  "cmdliner"
  "ppx_jane" {>= "v0.18" & < "v0.19"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
